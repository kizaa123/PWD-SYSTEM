# Copy to .env in the project root (same folder as docker-compose.yml).
# Required for production hosting with your own domain.

# Public hostname — must match DNS A/AAAA record pointing at the VPS
PWD_DOMAIN=register.yourassembly.gov.gh

# Long random string (openssl rand -hex 32). Invalidates old login tokens when changed.
PWD_TOKEN_SECRET=change-me-to-a-long-random-secret

# Optional: load demo regions/users on first empty database (set false after go-live)
PWD_SEED_DEMO=true
